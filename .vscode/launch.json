{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "ConfigReader",
            "request": "launch",
            "mainClass": "remindme.Email.ConfigReader",
            "projectName": "RemindMe"
        },
        {
            "type": "java",
            "name": "EncryptConfigFile",
            "request": "launch",
            "mainClass": "remindme.Email.EncryptConfigFile",
            "projectName": "RemindMe"
        },
        {
            "type": "java",
            "name": "MainApp",
            "request": "launch",
            "mainClass": "remindme.MainApp",
            "projectName": "RemindMe"
        },
        {
            "type": "java",
            "name": "MainApp Background",
            "request": "launch",
            "mainClass": "remindme.MainApp",
            "projectName": "RemindMe",
            "args": "--background"
        },
        {
            "type": "java",
            "name": "MainApp Serve",
            "request": "launch",
            "mainClass": "remindme.MainApp",
            "projectName": "RemindMe",
            "args": "--serve"
        },
        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}"
        },
        {
            "type": "node-terminal",
            "name": "RemindMe App (Electron dev)",
            "request": "launch",
            "command": "npm run dev",
            "cwd": "${workspaceFolder}/app"
        }
    ],
    "compounds": [
        {
            "name": "RemindMe (Full Stack Dev)",
            "configurations": ["MainApp Serve", "RemindMe App (Electron dev)"],
            "stopAll": true
        }
    ]
}