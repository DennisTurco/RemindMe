{
  "name": "remindme",
  "private": true,
  "version": "2.0.0",
  "description": "A lightweight, cross-platform app to schedule and manage custom periodic reminders.",
  "author": "Dennis Turco",
  "homepage": "https://github.com/DennisTurco/RemindMe",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && npm run build:electron-main && electron dist-electron/main.js",
    "dev:vite-only": "vite",
    "build:electron-main": "tsc -p electron/tsconfig.json && node -e \"require('fs').writeFileSync('dist-electron/package.json', JSON.stringify({type:'commonjs'}))\"",
    "build": "tsc -b && vite build && npm run build:electron-main",
    "build:backend": "cd .. && mvn -o package -DskipTests",
    "build:electron": "npm run build && npm run build:backend && electron-builder",
    "build:linux": "npm run build && npm run build:backend && electron-builder --linux",
    "build:mac": "npm run build && npm run build:backend && electron-builder --mac",
    "typecheck": "tsc --noEmit && tsc --noEmit -p electron/tsconfig.json"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.26.2",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "it.dennisturco.remindme",
    "productName": "RemindMe",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "res",
        "to": "res"
      },
      {
        "from": "../target/RemindMe-1.0-SNAPSHOT-jar-with-dependencies.jar",
        "to": "backend/RemindMe.jar"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": "dir",
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "../jre",
          "to": "jre"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "res/img/logo.png",
      "category": "Utility",
      "maintainer": "Dennis Turco <d.turco@dotblue.it>",
      "synopsis": "Schedule and manage custom periodic reminders",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "extraResources": [
        {
          "from": "../jre-linux",
          "to": "jre"
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "res/img/logo.png",
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "extraResources": [
        {
          "from": "../jre-mac-${arch}",
          "to": "jre"
        }
      ]
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libayatana-appindicator3-1 | libappindicator3-1"
      ]
    }
  }
}
